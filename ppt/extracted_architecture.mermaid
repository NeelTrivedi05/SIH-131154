    O15["Zone 1 shed equals zero"]
    O16["Zone 3 shed before Zone 2"]
    O17["Heat balance"]
    O18["Fuel, starts, wet-stacking and shed penalties"]
    O1 --> O2 --> O3 --> O4
    O5 --> O10
    O6 --> O10
    O7 --> O10
    O8 --> O10
    O9 --> O17
    O10 --> O11 --> O12 --> O13 --> O14 --> O15 --> O16 --> O17 --> O18
  end

