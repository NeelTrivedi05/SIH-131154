flowchart TD
  A["PolarEMS<br/>Offline Advisory Energy Management Simulator"] --> B["Light Industrial UI"]
  A --> C["Antarctic Stations"]
  C --> C1["Maitri"]
  C --> C2["Bharati"]

  subgraph Principles["Honesty and Safety"]
    P1["SIMULATED results"]
    P2["ASSUMED placeholders clearly marked"]
    P3["REAL data only when uploaded"]
    P4["SYNTHETIC data reproducible by seed"]
    P5["Advisory only"]
    P6["No hardware control"]
    P7["No invented metrics"]
  end

  subgraph Stack["Offline Technology Stack"]
    S1["Python 3.11"]
    S2["FastAPI"]
    S3["SQLite"]
    S4["Pydantic"]
    S5["NumPy and pandas"]
    S6["scikit-learn"]
    S7["statsmodels"]
    S8["pvlib"]
    S9["PuLP with HiGHS or CBC"]
    S10["scipy.optimize.milp fallback"]
    S11["React and Vite"]
    S12["TypeScript"]
    S13["Recharts"]
    S14["SSE live updates"]
    S15["Docker Compose"]
  end

  subgraph Config["Station Configuration"]
    Cfg1["YAML loader"]
    Cfg2["Required-field validation"]
    Cfg3["Startup ASSUMED warning"]
    Cfg4["Provenance tag on every value"]
    Cfg5["Easy replacement of placeholders"]
    Cfg6["No assumed renewable availability"]
    Cfg1 --> Cfg2 --> Cfg3
    Cfg1 --> Cfg4
  end

  subgraph Data["Data Sources"]
    D1["Synthetic physics-informed generator"]
    D2["CSV replay importer"]
    D3["Simulated Modbus-style feed"]
    D4["Optional offline forecast file"]
    D5["REAL"]
    D6["SYNTHETIC"]
    D7["No silent tag mixing"]
    D1 --> D6
    D2 --> D5
    D1 --> D7
    D2 --> D7
  end

  subgraph Pipeline["Four-Layer Simulation Loop"]
    Sense["1. SENSE<br/>Read-only ingest and validation"]
    Predict["2. PREDICT<br/>Forecasts, estimator, thermal twin"]
    Optimize["3. OPTIMIZE<br/>Rolling-horizon MILP"]
    Advise["4. ADVISE AND PROTECT<br/>Actions, fallback, alerts, audit"]
    Sense --> Predict --> Optimize --> Advise --> Sense
  end

  subgraph Validation["Sense Validation"]
    V1["Range checks"]
    V2["Rate-of-change checks"]
    V3["Physics power-balance checks"]
    V4["Gap flags"]
    V5["Bad data flagged"]
    V1 --> V5
    V2 --> V5
    V3 --> V5
    V4 --> V5
  end

  subgraph Prediction["Prediction Services"]
    E1["BMS SoC primary"]
    E2["Kalman consistency check"]
    E3["Disagreement alert"]
    F1["Ridge load forecast"]
    F2["Lag, hour, temperature features"]
    F3["P10, P50, P90 bands"]
    F4["24 to 72 hour horizon"]
    F5["Persistence baseline"]
    F6["Fallback if ridge does not beat persistence"]
    R1["PV nowcast and persistence"]
    R2["pvlib sun position"]
    R3["Observed cloud factor"]
    R4["Wind power curve"]
    R5["Widen bands when forecast absent"]
    T1["Lumped RC thermal model"]
    T2["Outside-temperature heat demand"]
    T3["CHP recoverable heat"]
    T4["Boiler shortfall"]
    E1 --> E2 --> E3
    F1 --> F2 --> F3 --> F4
    F1 --> F5 --> F6
    R1 --> R2 --> R3
    R1 --> R4
    R1 --> R5
    T1 --> T2
    T1 --> T3
    T1 --> T4
  end

  subgraph Optimizer["Rolling-Horizon MILP"]
    O1["30-minute steps"]
    O2["24-hour horizon"]
    O3["Re-solve every step"]
    O4["Apply first step to simulation only"]
    O5["Genset commitment and dispatch"]
    O6["Battery charge, discharge, SoC"]
    O7["Renewable use and curtailment"]
    O8["Zone load shedding"]
    O9["Boiler heat"]
    O10["Power balance"]
